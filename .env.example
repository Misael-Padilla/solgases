# ============================================================
# SOLGASES — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores
# NUNCA commitear el archivo .env — está en .gitignore
# ============================================================

# Django
SECRET_KEY=your-secret-key-here-generate-one-at-djecrety.ir
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL
DB_NAME=solgases_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Email (opcional en desarrollo — dejar vacío para imprimir en consola)
# En producción: activar verificación en 2 pasos en Gmail y crear App Password
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
